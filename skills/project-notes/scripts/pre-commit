#!/bin/sh
# Pre-commit hook for the notes repo: check the tickets before every commit. See
# ../issue-tracker.md. Call it from the notes repo's own hook, e.g. .githooks/pre-commit:
#   exec ~/.claude/skills/project-notes/scripts/pre-commit
here=$(dirname "$(readlink -f "$0")")
out=$(NOTES_ROOT="$(git rev-parse --show-toplevel)" python3 "$here/check-tickets.py") || {
  printf '%s\n' "$out" | grep '^problem:'
  echo "Fix the tickets above, then commit again."
  exit 1
}
